# Copy this file to `.env` and fill in real values.

# ─────────────────────────────────────────────────────────────────────────────
# Environment
# ─────────────────────────────────────────────────────────────────────────────
# "production" (default) or "development". In development a missing
# JWT_SECRET_KEY is tolerated with an ephemeral per-process secret; in
# production the app refuses to start without one.
APP_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# Auth & secrets
# ─────────────────────────────────────────────────────────────────────────────
# JWT signing secret. MUST be a long random string and the SAME value
# everywhere (local + production). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# WARNING: changing this value logs out every existing user (invalidates tokens).
JWT_SECRET_KEY="set-a-long-random-secret-here"

# Encrypts Google OAuth refresh tokens at rest (app/crypto.py). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate: put the NEW key first, keep the old one so existing rows decrypt:
#   TOKEN_ENCRYPTION_KEY="new_key,old_key"
TOKEN_ENCRYPTION_KEY=""

# Guards POST /admin/migrate (sent as the X-Internal-Token header).
# The endpoint refuses to run at all when this is unset.
INTERNAL_ADMIN_TOKEN=""

# Guards GET /metrics (sent as the X-Internal-Token header).
INTERNAL_METRICS_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────
# Comma-separated list of exact allowed origins.
ALLOWED_ORIGINS="https://feelivate.com,https://www.feelivate.com"

# Set to "true" ONLY in development to allow every *.vercel.app preview origin.
# Leave unset in production — it would let any Vercel-hosted site make
# credentialed requests to this API.
# ALLOW_VERCEL_PREVIEW_ORIGINS="false"

# ─────────────────────────────────────────────────────────────────────────────
# Data protection
# ─────────────────────────────────────────────────────────────────────────────
# Bump when the privacy policy or terms change materially. Users whose recorded
# consent predates this value are re-prompted with the consent screen.
# Must match the "Last updated" date published on the policy pages.
CONSENT_POLICY_VERSION="2026-07-29"

# Days of inactivity after which a dormant account is erased by the nightly
# retention sweep. 0 = disabled. Whatever is set here MUST match the retention
# period stated in the Privacy Policy.
INACTIVE_ACCOUNT_RETENTION_DAYS="0"

# ─────────────────────────────────────────────────────────────────────────────
# Rate limits (optional overrides — sensible defaults in app/ratelimit.py)
# ─────────────────────────────────────────────────────────────────────────────
# RL_LOGIN_MAX="10"          # attempts per identity
# RL_LOGIN_WINDOW="900"      # seconds
# RL_SIGNUP_MAX="5"
# RL_OTP_SEND_MAX="5"
# RL_OTP_VERIFY_MAX="6"
# RL_CONTACT_MAX="3"

# ─────────────────────────────────────────────────────────────────────────────
# LLM providers (fallback chain: Groq → Groq → Groq → OpenAI)
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="openai/gpt-oss-120b"

# Final fallback in the chain + embeddings (do NOT commit real keys)
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENAI_LLM_MODEL="gpt-4o-mini"
# OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Not in the active fallback chain
# GEMINI_API_KEY="your-gemini-api-key-here"
# GEMINI_MODEL="gemini-1.5-flash"

# ─────────────────────────────────────────────────────────────────────────────
# Data stores
# ─────────────────────────────────────────────────────────────────────────────
# Postgres in production; omit for the local sqlite fallback (memory.db).
# Keep this instance in an EU region if you serve EU users.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname"

# Vector memory (optional)
# QDRANT_URL=""
# QDRANT_API_KEY=""

# Redis connection URL (optional/legacy)
# REDIS_URL="redis://localhost:6379/0"

# ─────────────────────────────────────────────────────────────────────────────
# Integrations
# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI=""
# GOOGLE_LOGIN_REDIRECT_URI=""

# RESEND_API_KEY=""
# FROM_EMAIL="noreply@feelivate.com"
# APP_URL="https://feelivate.com"
