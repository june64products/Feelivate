<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window-level theme only; the real design system lives in Compose (ui/theme). -->
    <style name="Theme.Feelivate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/feelivate_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
